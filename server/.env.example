NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/pizzahop?replicaSet=rs0
CORS_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_VERIFICATION_TTL=24h
EMAIL_VERIFICATION_RESEND_COOLDOWN=60s
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
JWT_REFRESH_TTL=7d
TOKEN_HASH_PEPPER=replace-with-a-random-pepper-at-least-32-bytes
AUTH_COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_VERIFY_RATE_LIMIT_MAX=10
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=5
TRUST_PROXY_HOPS=0
